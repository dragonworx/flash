{
  "name": "flash-tui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "flash — a full-screen, keyboard-driven terminal file manager",
  "bin": {
    "flash": "./dist/flash.js"
  },
  "scripts": {
    "dev": "bun --hot run src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx biome check src/",
    "lint:fix": "bunx biome check --write src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
